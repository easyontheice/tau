{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "strictNullChecks": true,
    "lib": ["DOM", "DOM.Iterable", "ES5", "ES6", "ES7"]
  },
  "include": ["src/**/*.ts"]
}